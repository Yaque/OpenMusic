<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_monitor_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/monitor_stopped"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btn_monitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_monitor" />
    </LinearLayout>

    <!-- 音域自选（默认全域） + 跟随开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/range_from"
            android:textSize="12sp"
            android:textColor="@color/text_hint" />

        <Spinner
            android:id="@+id/spin_from"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/range_to"
            android:textSize="12sp"
            android:textColor="@color/text_hint" />

        <Spinner
            android:id="@+id/spin_to"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_follow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/curve_follow"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btn_curve_reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/curve_clear" />
    </LinearLayout>

    <!-- 实时提示当前音高 -->
    <TextView
        android:id="@+id/tv_curve_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/curve_no_voice"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 曲线：拉长纵轴（每八度 7 条音线），上下滑动查看 -->
    <ScrollView
        android:id="@+id/curve_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <com.aiocw.openmusic.ui.PitchCurveView
            android:id="@+id/curve_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/curve_hint"
        android:textSize="11sp"
        android:textColor="@color/text_hint" />
</LinearLayout>
